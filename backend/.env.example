# ============================================================
# LAKSHMI DENTAL CARE — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# ─── Database (Supabase) ────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → Database → URI
# Direct connection (port 5432) — used for migrations & seeding
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.avfrozzjttgwthmznumq.supabase.co:5432/postgres?schema=public&sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.avfrozzjttgwthmznumq.supabase.co:5432/postgres?schema=public&sslmode=require"

# ─── Authentication ─────────────────────────────────────────
# Change this to a long random string in production
JWT_SECRET="LDC_SuperSecureEnterpriseClinicKey7739!"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ─── App ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── AWS S3 (for X-rays, photos, documents) ─────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=lakshmi-dental-care

# ─── Razorpay (Payments) ────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── WhatsApp / Twilio (Notifications) ──────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lakshmi Dental Care <noreply@lakshmidental.com>"

# ─── Redis (optional, for caching/queues) ───────────────────
REDIS_URL=redis://localhost:6379
